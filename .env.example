# Copy this file to backend/.env and adjust values as needed.
# Never commit the real .env file - it is already excluded in .gitignore.

# SQLite for local development. Later phases switch this to a PostgreSQL
# connection string, e.g. postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./wattledger.db

# Python logging level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# Default locale/timezone for date handling (CLAUDE.md section 4).
TIMEZONE=Asia/Kolkata

# Signs login tokens (JWT). Generate your own random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this logs out every existing session (all tokens become invalid).
SECRET_KEY=change-me-to-a-random-value

# How long a login stays valid, in minutes. 10080 = 7 days.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
