# Copy this to .env.production on the VPS (never commit the real file - it
# is already excluded in .gitignore) and fill in real values, then run:
#   docker compose --env-file .env.production up -d --build

# --- PostgreSQL ---
# Pick your own values - these just need to match between Postgres and the
# backend's DATABASE_URL, which docker-compose builds from them automatically.
POSTGRES_USER=wattledger
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=wattledger

# --- Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this later logs out every existing session.
SECRET_KEY=change-me-to-a-random-value
# Comma-separated - the real deployed origin(s), not "*".
CORS_ORIGINS=https://wattledger.aiwithbala.in
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# --- Domains (both need a DNS A record pointing at this VPS's IP) ---
API_DOMAIN=api.wattledger.aiwithbala.in
WEB_DOMAIN=wattledger.aiwithbala.in
