# Caddy automatically obtains and renews HTTPS certificates from Let's
# Encrypt for both domains below - no manual certbot/cron setup needed.
# {$API_DOMAIN} / {$WEB_DOMAIN} are filled in from docker-compose.yml's
# environment at container start (set in .env.production) - expected to be
# api.wattledger.aiwithbala.in and wattledger.aiwithbala.in. Both need their
# own DNS A record pointing at the VPS's IP for Let's Encrypt to issue
# certificates for them.

{$API_DOMAIN} {
	reverse_proxy backend:8000
}

{$WEB_DOMAIN} {
	root * /srv/web
	try_files {path} /index.html # Flutter web's own client-side routing
	file_server
}
