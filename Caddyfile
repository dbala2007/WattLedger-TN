# Static file server for the built Flutter web app only. No per-domain
# blocks and no HTTPS here - the shared Traefik instance already running on
# this VPS (see docker-compose.yml and docs/decisions/0006) does host-based
# routing and Let's Encrypt TLS termination before a request ever reaches
# this container, and forwards to it in plain HTTP on :80. The backend is
# reached by Traefik directly too (docker-compose.yml labels), not via this
# Caddyfile - reverse_proxy to it was removed when Traefik took over.

:80 {
	root * /srv/web
	try_files {path} /index.html # Flutter web's own client-side routing
	file_server
}
